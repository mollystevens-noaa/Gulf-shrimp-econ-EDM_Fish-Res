	file = {pnas.1910964117.sapp.pdf:C\:\\Users\\molly.stevens\\Zotero\\storage\\LN8588BM\\pnas.1910964117.sapp.pdf:application/pdf;pnas.1910964117.sd01.pdf:C\:\\Users\\molly.stevens\\Zotero\\storage\\MWKRZZ6F\\pnas.1910964117.sd01.pdf:application/pdf;Rogers and Munch - 2020 - Hidden similarities in the dynamics of a weakly sy.pdf:C\:\\Users\\molly.stevens\\Zotero\\storage\\72IFNENZ\\Rogers and Munch - 2020 - Hidden similarities in the dynamics of a weakly sy.pdf:application/pdf},
