@techreport{ices_working_2023,
	title = {Working {Group} on {Multispecies} {Assessment} {Methods} ({WGSAM}; outputs from 2022 meeting)},
	copyright = {Creative Commons Attribution 4.0 International},
	url = {https://ices-library.figshare.com/articles/report/Working_Group_on_Multispecies_Assessment_Methods_WGSAM_outputs_from_2022_meeting_/22087292},
	abstract = {The Working Group on Multispecies Assessment Methods (WGSAM) aims to advance the operational use of knowledge on predator-prey interactions for advice on fisheries and ecosystem management. This report presents an update of the multispecies SMS keyrun model for the Baltic Sea including its review by the working group, and the review of three modelling frameworks for the Georges Bank marine ecosystem. The Baltic Sea keyrun provides updated estimates of cod predation mortality for the Baltic Sea sprat and central Baltic herring stocks. The model integrates fishery and survey data on the two clupeids and makes extensive use of the cod stomach data (i.e. 64 000 stomachs are used as input to the model). Estimations of predation mortality are consistent with previous estimates and suitable for inclusion in the stock assessment of the two clupeid stocks. Predation remains low on all ages for both herring and sprat as a result of the low cod stock size. The large modelling framework for the Georges Bank comprises a multispecies production model, a multispecies length-based model and a mass-balanced ecosystem model. While none of the three models was at that stage to be evaluated as a keyrun, with further development they could complementarily and in conjunction contribute to the EBFM of the Georges Bank.},
	language = {en},
	urldate = {2023-03-06},
	institution = {ICES Scientific Reports},
	author = {ICES},
	year = {2023},
	doi = {10.17895/ICES.PUB.22087292},
	note = {Artwork Size: 14115701 Bytes},
	keywords = {Pressures, impacts, conservation, and management},
	pages = {14115701 Bytes},
	file = {ICES - 2023 - Working Group on Multispecies Assessment Methods (.pdf:C\:\\Users\\molly.stevens\\Zotero\\storage\\XYGNUPLP\\ICES - 2023 - Working Group on Multispecies Assessment Methods (.pdf:application/pdf},
}

