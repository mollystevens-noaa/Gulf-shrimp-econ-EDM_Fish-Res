	file = {Siple et al. - 2021 - Considerations for management strategy evaluation .pdf:C\:\\Users\\molly.stevens\\Zotero\\storage\\L25UT2GL\\Siple et al. - 2021 - Considerations for management strategy evaluation .pdf:application/pdf},
